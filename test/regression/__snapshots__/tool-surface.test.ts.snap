      "properties": {
        "force": {
          "default": false,
          "description": "Overwrite hand-edited managed-block content.",
          "type": "boolean",
        },
        "projectRoot": {
          "description": "Override the project root path. Defaults to the parent of the vault directory if not provided.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "regenerate_contract",
  },
  {
    "description": "Force regeneration of INDEX.md for one directory (or all affected by a list of paths). Idempotent — skips write if unchanged.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "description": "Directory path relative to vault root (mutually exclusive with 'paths')",
          "type": "string",
        },
        "paths": {
          "description": "Files to infer affected directories from",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "regenerate_index",
  },
  {
    "description": "Force a full reindex of the vault",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {},
      "type": "object",
    },
    "name": "reindex",
  },
  {
    "description": "[DEPRECATED — removed in v2.0.0; use manage_tags({action:'rename', from, to})] Rename a tag across all notes in the vault",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "newTag": {
          "type": "string",
        },
        "oldTag": {
          "type": "string",
        },
      },
      "required": [
        "oldTag",
        "newTag",
      ],
      "type": "object",
    },
    "name": "rename_tag",
  },
  {
    "description": "Graph traversal — find notes connected to a concept via wikilinks, related_docs, and specific tags. Results ranked by directness, load_priority, and degree.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "concept": {
          "type": "string",
        },
        "limit": {
          "default": 20,
          "type": "number",
        },
        "maxDepth": {
          "default": 2,
          "type": "number",
        },
      },
      "required": [
        "concept",
      ],
      "type": "object",
    },
    "name": "search_graph",
  },
  {
    "description": "Combined semantic + graph search — vector results re-ranked by graph proximity and load_priority, and down-weighted by confidence decay (time since last_verified); decayed results carry a \`decay\` block.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "description": "Filter by frontmatter domain",
          "type": "string",
        },
        "limit": {
          "default": 10,
          "type": "number",
        },
        "modifiedAfter": {
          "description": "ISO date — only return notes modified after this date",
          "type": "string",
        },
        "modifiedBefore": {
          "description": "ISO date — only return notes modified before this date",
          "type": "string",
        },
        "query": {
          "type": "string",
        },
        "status": {
          "description": "Filter by frontmatter status",
          "type": "string",
        },
        "tier": {
          "description": "Filter by frontmatter tier",
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "search_hybrid",
  },
  {
    "description": "Vector similarity search — find notes similar to a query by meaning. Scores are boosted by load_priority and down-weighted by confidence decay (time since last_verified); decayed results carry a \`decay\` block. Set decay.enabled:false in vault.schema.yml to disable.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "description": "Filter by frontmatter domain (e.g. 'api', 'security')",
          "type": "string",
        },
        "limit": {
          "default": 10,
          "type": "number",
        },
        "modifiedAfter": {
          "description": "ISO date — only return notes modified after this date (e.g. '2026-01-01')",
          "type": "string",
        },
        "modifiedBefore": {
          "description": "ISO date — only return notes modified before this date",
          "type": "string",
        },
        "query": {
          "type": "string",
        },
        "status": {
          "description": "Filter by frontmatter status (e.g. 'active', 'draft')",
          "type": "string",
        },
        "tier": {
          "description": "Filter by frontmatter tier (e.g. 'guide', 'reference')",
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "search_semantic",
  },
  {
    "description": "Full-text keyword or regex search across all notes with optional filters",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "caseSensitive": {
          "default": false,
          "type": "boolean",
        },
        "domain": {
          "description": "Filter by frontmatter domain",
          "type": "string",
        },
        "limit": {
          "default": 20,
          "type": "number",
        },
        "modifiedAfter": {
          "description": "ISO date — only return notes modified after this date",
          "type": "string",
        },
        "modifiedBefore": {
          "description": "ISO date — only return notes modified before this date",
          "type": "string",
        },
        "pathGlob": {
          "type": "string",
        },
        "pattern": {
          "type": "string",
        },
        "regex": {
          "default": false,
          "type": "boolean",
        },
        "status": {
          "description": "Filter by frontmatter status",
          "type": "string",
        },
        "tagFilter": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "tier": {
          "description": "Filter by frontmatter tier",
          "type": "string",
        },
      },
      "required": [
        "pattern",
      ],
      "type": "object",
    },
    "name": "search_text",
  },
  {
    "description": "Close the active session. HARD GATED: refused without recorded verifications unless verified=false is passed with a \`reason\` waiving verification (e.g. for prose-only edits). Deletes session state on success.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Required when verified=false. Why verification is not applicable to this task.",
          "type": "string",
        },
        "summary": {
          "description": "One-line description of what was accomplished. Appears in the closeout log entry.",
          "type": "string",
        },
        "verified": {
          "default": true,
          "description": "Pass false to explicitly waive verification (requires \`reason\`).",
          "type": "boolean",
        },
      },
      "required": [
        "summary",
      ],
      "type": "object",
    },
    "name": "session_finish",
  },
  {
    "description": "Run a verification command inside the active session. Captures exit code, signal, duration, and a tail of stdout+stderr. Refused when no session is open. Default timeout: 5 minutes.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "description": "Shell command to run, e.g. 'npm test' or 'go test ./...'.",
          "type": "string",
        },
        "timeout_ms": {
          "description": "Override the default 5-minute timeout (in milliseconds).",
          "exclusiveMinimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "cmd",
      ],
      "type": "object",
    },
    "name": "session_run",
  },
  {
    "description": "Open a verification-gated session for a multi-step task. State persists at .claude/.semantic-memory/session.json. Refuses if a session is already open with a different task. Calling with the same task as an open session returns the existing id (idempotent).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "task": {
          "description": "Short description of the task being worked on. Recorded in session state and surfaced at session_finish.",
          "type": "string",
        },
      },
      "required": [
        "task",
      ],
      "type": "object",
    },
    "name": "session_start",
  },
  {
    "description": "Read-only inspection of the active session — task, verifications, notes_touched, and a state label (active | stale | no_session). 'stale' indicates last_activity_at >24h ago.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {},
      "type": "object",
    },
    "name": "session_status",
  },
  {
    "description": "Turn a researched answer + sources into a new filed note with provenance frontmatter and auto-wikilinks. Builds a ChangeSet and applies it (dry-run supported). The primary path from query-answer to durable vault artifact. Pass \`proposal: true\` to file the result under \`proposals/<date>-<slug>.md\` with \`status: proposal\` for review-first workflows; \`synthesize_promote\` then moves it to the canonical destination.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": "string",
        },
        "confidence": {
          "default": "medium",
          "type": "string",
        },
        "decided_on": {
          "type": "string",
        },
        "decision_maker": {
          "type": "string",
        },
        "derived_from": {
          "description": "Wikilinks to other vault notes — populate provenance.derived_from",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "dry_run": {
          "default": false,
          "type": "boolean",
        },
        "from_session": {
          "default": false,
          "description": "When true, pull defaults from the active session: prepend a verification summary to \`answer\`, default \`derived_from\` to session.notes_touched, and append session id+task to \`sources\`. No-op when no session is active.",
          "type": "boolean",
        },
        "proposal": {
          "default": false,
          "description": "Write to proposals/<date>-<slug>.md with status:proposal instead of the canonical destination. Use for review-first workflows.",
          "type": "boolean",
        },
        "proposal_subdir": {
          "description": "Override the proposal subdirectory (default 'proposals'). Useful for source segregation, e.g. 'proposals/research'.",
          "type": "string",
        },
        "related_notes": {
          "description": "Note names or paths to auto-link in the body + list under Related",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "severity": {
          "type": "string",
        },
        "sources": {
          "description": "External URLs or paths — populate provenance.sources",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "status": {
          "default": "active",
          "type": "string",
        },
        "suggested_path": {
          "description": "Target path relative to vault root, e.g. 'decisions/auth-migration.md'. In proposal mode, this is recorded as proposed_target frontmatter and the actual write goes to proposals/.",
          "type": "string",
        },
        "symptoms": {
          "description": "Verbatim symptom phrases in the user's own words (e.g. 'it hangs after the second reindex'). Stored as \`symptoms:\` frontmatter and symptom-keyed at index time so terse symptom queries match this note — the retrieval key for next time.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "topic": {
          "type": "string",
        },
        "type": {
          "default": "note",
          "description": "One of the schema types: note, decision, gotcha, source",
          "type": "string",
        },
      },
      "required": [
        "topic",
        "answer",
        "suggested_path",
      ],
      "type": "object",
    },
    "name": "synthesize_note",
  },
  {
    "description": "Move a reviewed proposal note to its canonical destination. Reads the proposal's frontmatter (which must have \`status: proposal\` and \`proposed_target\`), strips proposal markers, restores canonical status, and atomically creates the target + deletes the proposal. Optional \`target_path\` overrides the proposal's recorded \`proposed_target\`.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "default": false,
          "type": "boolean",
        },
        "proposal_path": {
          "description": "Path to the proposal note relative to vault root, e.g. 'proposals/2026-05-08-auth-flow.md'",
          "type": "string",
        },
        "target_path": {
          "description": "Optional destination override. When omitted, uses the proposal's own \`proposed_target\` frontmatter.",
          "type": "string",
        },
      },
      "required": [
        "proposal_path",
      ],
      "type": "object",
    },
    "name": "synthesize_promote",
  },
  {
    "description": "Set or delete YAML frontmatter keys — pass null to delete a key",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "additionalProperties": {},
          "type": "object",
        },
        "path": {
          "type": "string",
        },
      },
      "required": [
        "path",
        "fields",
      ],
      "type": "object",
    },
    "name": "update_frontmatter",
  },
  {
    "description": "Edit note content — overwrite, append, prepend, or patch by heading",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
        },
        "heading": {
          "type": "string",
        },
        "mode": {
          "enum": [
            "overwrite",
            "append",
            "prepend",
            "patch-by-heading",
          ],
          "type": "string",
        },
        "path": {
          "type": "string",
        },
      },
      "required": [
        "path",
        "content",
        "mode",
      ],
      "type": "object",
    },
    "name": "update_note",
  },
  {
    "description": "Re-verify a note: stamp \`last_verified\` to today WITHOUT changing content or any other frontmatter field, and log a \`verify\` event. Resets the confidence-decay clock so the note ranks fresh again. Returns the note's new decay multiplier (typically 1.0).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
        },
      },
      "required": [
        "path",
      ],
      "type": "object",
    },
    "name": "verify_note",
  },
]
`;

exports[`Regression: MCP tool surface in --read-only mode > matches the golden tool-name list in read-only mode 1`] = `
[
  "backlinks",
  "find_broken_links",
  "find_missing_provenance",
  "find_schema_violations",
  "find_stale",
  "forwardlinks",
  "get_frontmatter",
  "get_stats",
  "graph_path",
  "graph_statistics",
  "lint_vault",
  "list_notes",
  "log_event",
  "log_query",
  "read_multiple_notes",
  "read_note",
  "reindex",
  "search_graph",
  "search_hybrid",
  "search_semantic",
  "search_text",
]
`;
